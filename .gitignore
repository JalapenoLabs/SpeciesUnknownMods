# Release zips and anything unpacked from the game never belong in the repository.
/dist/
/extracted/
*.zip

# Unreal authoring project: build output and caches.
/unreal/SpeciesUnknown/Binaries/
/unreal/SpeciesUnknown/Intermediate/
/unreal/SpeciesUnknown/Saved/
/unreal/SpeciesUnknown/DerivedDataCache/
/unreal/SpeciesUnknown/.vscode/
/unreal/SpeciesUnknown/*.code-workspace
/unreal/SpeciesUnknown/Makefile
# Generated by the editor-only asset builder from code (Source/SpeciesUnknownModKit); never hand-edited.
/unreal/SpeciesUnknown/Content/Mods/

# Python bytecode caches.
__pycache__/
